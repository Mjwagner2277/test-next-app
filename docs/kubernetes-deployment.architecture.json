      "pad": 18
    },
    {
      "kind": "security-group",
      "label": "same-origin request boundary",
      "wraps": ["gatewayDataPlane", "httpRoute"],
      "pad": 14
    }
  ],
  "connections": [
    {
      "from": "operatorBrowser",
      "to": "gatewayDataPlane",
      "label": "HTTP on GUI port",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": 56
    },
    {
      "from": "gatewayController",
      "to": "gatewayDataPlane",
      "label": "programs Envoy",
      "variant": "dashed",
      "labelAt": [318, 230]
    },
    {
      "from": "gatewayDataPlane",
      "to": "httpRoute"
    },
    {
      "from": "httpRoute",
      "to": "appService",
      "label": "/*",
      "variant": "emphasis"
    },
    {
      "from": "appService",
      "to": "appPod",
      "label": "serve Next.js"
    },
    {
      "from": "httpRoute",
      "to": "grpcWebService",
      "label": "/controlpanel.v1.SignalStimService/*",
      "variant": "emphasis"
    },
    {
      "from": "grpcWebService",
      "to": "grpcWebProxy",
      "label": "gRPC-Web :8080"
    },
    {
      "from": "grpcWebProxy",
      "to": "nativeGrpcServer",
      "label": "HTTP/2 native gRPC",
      "variant": "security",
      "labelDy": 59
    },
    {
      "from": "helmChart",
      "to": "httpRoute",
      "label": "renders Gateway API",
      "variant": "dashed"
    },
    {
      "from": "dockerBuild",
      "to": "appImage",
      "variant": "dashed"
    },
    {
      "from": "appImage",
      "to": "appPod"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Same-Port Routing",
      "items": [
        "The browser uses the same origin for GUI assets and gRPC-Web calls",
        "HTTPRoute sends service paths to Envoy and all other paths to Next.js"
      ]
    },
    {
      "dot": "amber",
      "title": "gRPC-Web Bridge",
      "items": [
        "The chart-managed Envoy proxy applies the grpc_web filter",
        "The native gRPC server stays behind cluster routing and is not exposed to browser config"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local Kind Loop",
      "items": [
        "Build with build/Dockerfile, load the image into kind, then install the Helm chart",
        "Port-forward the Envoy Gateway data-plane service to test the same external port locally"
      ]
    }
  ]
}
