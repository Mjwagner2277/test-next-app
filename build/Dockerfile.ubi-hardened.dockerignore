# Keep local dependencies out of the Docker build context. The image installs
# dependencies from package-lock.json inside the deps stage instead.
node_modules

# Build outputs are regenerated inside the Docker builder stage.
.next
dist

# Local env files should not be baked into images. Pass runtime config with
# Kubernetes, Helm values, or another deployment platform.
.env
.env.*
!.env.example

# Generated docs and mockups are useful repo artifacts, but they are not build
# inputs for the application image.
docs
mockup

# Local/editor noise that should not affect Docker layer hashes.
.DS_Store
*.log
.git
.gitignore
