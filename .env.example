# Server-only gRPC-Web endpoint for the Next.js RPC relay. For local development,
# run or port-forward Envoy on port 8080, then copy this file to .env.local.
# Helm sets this to its internal Envoy Service automatically.
SIGNAL_STIM_UPSTREAM_URL=http://127.0.0.1:8080

# Maximum upstream call duration; shorter caller deadlines are preserved.
SIGNAL_STIM_TIMEOUT_MS=30000

# Maximum decoded payload bytes per JSON log entry. Larger payloads have a
# marked preview; truncation affects logs only, never forwarded signals.
RPC_LOG_MAX_PAYLOAD_BYTES=65536

# The browser calls the same origin that served the page. Both GUI paths and
# /controlpanel.v1.SignalStimService/* must route to the Next.js app so requests
# and responses appear in the next-app container's stdout logs.
