# Browser code loads this value from the Next.js /api/grpc-config route. Envoy
# then forwards to the native gRPC server configured in Helm values.
GRPC_WEB_PROXY_URL=http://localhost:8080

# This is public because /api/grpc-config returns it to the browser. Leave
# empty unless the token is safe for end users to inspect.
GRPC_WEB_AUTH_TOKEN=
